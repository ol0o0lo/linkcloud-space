FROM postgres:17

# postgres:17 官方镜像同时支持 amd64/arm64。直接安装 PGDG 仓库中与
# PostgreSQL 17 匹配的 PostGIS 包，避免依赖仅发布 amd64 的 postgis/postgis 镜像。
RUN --mount=type=cache,target=/var/cache/apt,id=linkcloud-space-db-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,id=linkcloud-space-db-apt-lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        postgresql-$PG_MAJOR-postgis-3 \
        postgresql-$PG_MAJOR-postgis-3-scripts
