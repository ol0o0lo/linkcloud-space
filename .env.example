# Django core
DEBUG=on
SECRET_KEY=change-me-generate-with-just-create-env
ALLOWED_HOSTS=localhost,127.0.0.1
INTERNAL_IPS=127.0.0.1,0.0.0.0

# Database
POSTGRES_USER=django-base-site
POSTGRES_DB=django-base-site
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DB_SSL_REQUIRED=false

# Redis / cache
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=

# Docker Compose
COMPOSE_BAKE=true
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
HOST_UID=1000
HOST_GID=1000

# Development
USE_DOCKER=false
USE_DEBUGPY=
IS_DEBUG_LOGGING_ON=false
VITE_DEV_MODE=true
READ_DOT_ENV_FILE=true

# Site / proxy
SITE_DOMAIN=localhost:8000
SITE_SCHEME=http
CSRF_TRUSTED_ORIGINS=
SECURE_PROXY_SSL_HEADER=false

# Amap (高德地图)
AMAP_JSAPI_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY=

# Auth
ACCOUNT_SIGNUP_OPEN=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_MINIPROGRAM_PC_LOGIN_ENV_VERSION=release
WECHAT_MINIPROGRAM_PC_LOGIN_CHECK_PATH=true
WECHAT_MINIPROGRAM_URL_LINK_ENABLED=true
WECHAT_MINIPROGRAM_URL_LINK_ENV_VERSION=release
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
WECHAT_OFFICIAL_ACCOUNT_TOKEN=

# Media storage: local MinIO defaults
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
STATICFILES_STORAGE=
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_ENDPOINT_URL=http://minio:9000
MEDIA_S3_URL_ENDPOINT_URL=http://localhost:9000
MEDIA_S3_BUCKET_NAME=media
MEDIA_S3_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional real S3 / SES
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=us-east-2

# Email
DEFAULT_FROM_EMAIL=
EMAIL_URL=

# SMS
SMS_BACKEND=apps.base.sms.console.ConsoleSMSBackend
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_STS_ACCESS_KEY_ID=
ALIYUN_STS_ACCESS_KEY_SECRET=
ALIYUN_STS_ROLE_ARN=
ALIYUN_STS_ROLE_SESSION_NAME=oss-upload
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# AI foundation（密钥只放环境变量，数据库仅保存变量名）
AI_ENABLED=false
AI_MAX_INPUT_CHARS=100000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_CONVERSATION_MESSAGES=40
AI_TEMPORARY_RETENTION_HOURS=24
AI_STREAM_TIMEOUT_SECONDS=120
AI_CHAT_PROMPT_KEY=general.chat
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
ARK_API_KEY=

# Instance
INSTANCE=dev
NOTIFICATIONS_RETENTION_DAYS=90
