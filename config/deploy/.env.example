# 同一台服务器上多个部署使用不同项目名；部署后保持项目名不变。
COMPOSE_PROJECT_NAME=linkcloud-space-prod
APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/link2cloud/linkcloud-space:latest
POSTGIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/link2cloud/linkcloud-space-postgis:17

# 下面三个值必须填写。分别执行 openssl rand -hex 32 生成。
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTGRES_USER=linkcloud-space
POSTGRES_DB=linkcloud-space

# 2 核 4GB、低并发场景的轻量默认配置。
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
CELERY_WORKER_CONCURRENCY=1
NGINX_WORKER_PROCESSES=1
POSTGRES_MAX_CONNECTIONS=32
POSTGRES_SHARED_BUFFERS=128MB

# 直接通过 IP 访问时，将 ALLOWED_HOSTS 和 SITE_DOMAIN 改成服务器 IP。
# ALLOWED_HOSTS 不带协议和端口，多个值以英文逗号分隔。
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_DOMAIN=localhost:8080
SITE_SCHEME=http
CSRF_TRUSTED_ORIGINS=http://localhost:8080

READ_DOT_ENV_FILE=false
INSTANCE=prod
NOTIFICATIONS_RETENTION_DAYS=90

# 默认使用持久卷保存上传文件。接入阿里云 OSS 时取消注释下面变量，并注释掉 DEFAULT_FILE_STORAGE。
# MEDIA_S3_ACCESS_KEY=
# MEDIA_S3_SECRET_KEY=
# MEDIA_S3_ENDPOINT_URL=https://oss-cn-shenzhen.aliyuncs.com
# MEDIA_S3_BUCKET_NAME=linkcloud-space
# MEDIA_S3_REGION=oss-cn-shenzhen
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
ACCOUNT_SIGNUP_OPEN=false
EMAIL_URL=
DEFAULT_FROM_EMAIL=
