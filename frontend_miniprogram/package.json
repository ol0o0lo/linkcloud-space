{
  "name": "linkcloud-space-miniprogram",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "description": "链云空间微信小程序与 H5 客户端",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "openapi": "openapi-ts",
    "init-base-files": "node ./scripts/create-base-files.js",
    "prepare": "pnpm init-base-files",
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm dev:h5",
    "dev:h5": "pnpm init-base-files && uni",
    "dev:h5:test": "pnpm init-base-files && uni --mode test",
    "dev:h5:prod": "pnpm init-base-files && uni --mode production",
    "dev:mp": "pnpm init-base-files && uni -p mp-weixin",
    "dev:mp:test": "pnpm init-base-files && uni -p mp-weixin --mode test",
    "dev:mp:prod": "pnpm init-base-files && uni -p mp-weixin --mode production",
    "dev:mp-weixin": "pnpm dev:mp",
    "build": "pnpm build:h5",
    "build:h5": "pnpm init-base-files && uni build",
    "build:h5:test": "pnpm init-base-files && uni build --mode test",
    "build:h5:prod": "pnpm init-base-files && uni build --mode production",
    "build:mp": "pnpm init-base-files && uni build -p mp-weixin",
    "build:mp:test": "pnpm init-base-files && uni build -p mp-weixin --mode test",
    "build:mp:prod": "pnpm init-base-files && uni build -p mp-weixin --mode production",
    "build:mp-weixin": "pnpm build:mp",
    "bump-version": "node ./scripts/bump-version.js",
    "upload:mp": "node ./scripts/upload-weixin.js",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm build:h5:prod && pnpm build:mp:prod"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@dcloudio/uni-components": "3.0.0-4070620250821001",
    "@dcloudio/uni-h5": "3.0.0-4070620250821001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4070620250821001",
    "@tdesign/uniapp": "1.0.0",
    "@tdesign/uniapp-chat": "1.0.0",
    "@wot-ui/ui": "2.0.8",
    "dayjs": "1.11.10",
    "pinia": "2.0.36",
    "vue": "^3.4.21",
    "vue-i18n": "9.1.9",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-4070620250821001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4070620250821001",
    "@iconify-json/carbon": "^1.2.4",
    "@iconify/utils": "^3.0.2",
    "@types/node": "^20.17.9",
    "@uni-helper/eslint-config": "0.5.0",
    "@uni-helper/plugin-uni": "0.1.0",
    "@uni-helper/uni-env": "0.1.8",
    "@uni-helper/uni-types": "1.0.0-alpha.6",
    "@uni-helper/unocss-preset-uni": "0.2.11",
    "@uni-helper/vite-plugin-uni-components": "0.2.3",
    "@uni-helper/vite-plugin-uni-layouts": "0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "0.2.12",
    "@uni-helper/vite-plugin-uni-pages": "0.3.23",
    "@uni-helper/vite-plugin-uni-platform": "0.0.5",
    "@uni-ku/bundle-optimizer": "v1.3.15-beta.2",
    "@uni-ku/root": "1.4.1",
    "@unocss/eslint-plugin": "^66.2.3",
    "@unocss/preset-legacy-compat": "66.0.0",
    "@vue/runtime-core": "^3.4.21",
    "enquirer": "^2.4.1",
    "eslint": "^9.31.0",
    "eslint-plugin-format": "^1.0.1",
    "miniprogram-api-typings": "^4.1.0",
    "miniprogram-ci": "^2.1.26",
    "openapi-ts-request": "^1.10.0",
    "picocolors": "^1.1.1",
    "postcss": "^8.4.49",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "1.77.8",
    "typescript": "~5.8.0",
    "unocss": "66.0.0",
    "unplugin-auto-import": "^20.0.0",
    "vite": "5.2.8",
    "vue-tsc": "^3.0.6"
  },
  "overrides": {
    "unconfig": "7.3.2"
  }
}
