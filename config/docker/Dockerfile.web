# ------------------------------------------------------------
# STAGE 1: Build Python requirements layer
# ------------------------------------------------------------
FROM python:3.14-bookworm AS python-requirements

ARG ENV_NAME=dev

ENV VIRTUAL_ENV=/opt/venv
ENV \
    # This prevents Python from writing out pyc files \
    PYTHONDONTWRITEBYTECODE=1 \
    # This keeps Python from buffering stdin/stdout \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=$VIRTUAL_ENV

RUN --mount=type=cache,target=/root/.cache/pip,id=linkcloud-space-pip \
    set -ex \
    && python3 -m venv $VIRTUAL_ENV \
    && $VIRTUAL_ENV/bin/pip install -U setuptools wheel pip uv

# Install Python packages
COPY uv.lock pyproject.toml ./

RUN --mount=type=cache,target=/root/.cache/uv,id=linkcloud-space-uv \
    set -ex \
    && if [ "$ENV_NAME" = "prod" ]; then \
        $VIRTUAL_ENV/bin/uv sync --locked --no-dev; \
    else \
        $VIRTUAL_ENV/bin/uv sync --locked; \
    fi


# ------------------------------------------------------------
# STAGE 2: Base runtime (shared by dev and prod). libjpeg-dev + zlib1g-dev
# are needed for Pillow (avatar uploads). mime-support gives gunicorn the
# correct mime types when serving static files.
# ------------------------------------------------------------
FROM python:3.14-slim-bookworm AS base

ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
ARG DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

RUN --mount=type=cache,target=/var/cache/apt,id=linkcloud-space-apt-cache,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,id=linkcloud-space-apt-lists,sharing=locked \
    sed -i \
        -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
        -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -yqq --no-install-recommends binutils gdal-bin libgdal-dev libgeos-dev libproj-dev locales mime-support libjpeg-dev zlib1g-dev \
    && echo "LC_ALL=en_US.UTF-8" >> /etc/environment \
    && echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen \
    && echo "LANG=en_US.UTF-8" > /etc/locale.conf \
    && locale-gen en_US.UTF-8 \
    && echo "\nsource /opt/venv/bin/activate" >> /root/.bashrc

ENV VIRTUAL_ENV=/opt/venv
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    DJANGO_SETTINGS_MODULE=config.settings \
    PYTHONPATH=/srv/app \
    TERM=xterm-color \
    PATH=$VIRTUAL_ENV/bin:${PATH}

WORKDIR /srv/app

COPY --from=python-requirements $VIRTUAL_ENV $VIRTUAL_ENV


# ------------------------------------------------------------
# STAGE 2b: Dev layer (adds Playwright for e2e tests)
# ------------------------------------------------------------
FROM base AS dev

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN playwright install chromium --with-deps \
    && chmod -R a+rX /ms-playwright

# Pre-compile site-packages to .pyc so imports don't recompile at runtime —
# `PYTHONDONTWRITEBYTECODE=1` blocks runtime caching, which means SyntaxWarnings
# (e.g. pluggy 1.5.0 on Python 3.14) re-fire on every import. `compileall -q`
# bakes the .pyc cache in once so those warnings stay quiet.
RUN python -W ignore -m compileall -q /opt/venv/lib

EXPOSE 8000/tcp 8001/tcp

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]


# ------------------------------------------------------------
# STAGE 3: Admin assets (npm) and H5 assets (pnpm)
# Browser assets are shared across runtime architectures; build them natively.
# ------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS admin_assets

ENV HUSKY=0
WORKDIR /build/frontend_admin

COPY frontend_admin/ ./

RUN --mount=type=cache,target=/root/.npm,id=linkcloud-space-npm \
    npm ci && npm run build


FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS h5_assets

WORKDIR /build/frontend_miniprogram

# Build without developer .env files; H5 uses the Django host's /api.
ENV VITE_APP_TITLE="链云空间" \
    VITE_APP_PUBLIC_BASE=/public/static/dist/h5/ \
    VITE_API_MODE=same-origin \
    VITE_API_BASE_URL=/api \
    VITE_APP_PROXY_ENABLE=false \
    VITE_DELETE_CONSOLE=true

RUN corepack enable

COPY frontend_miniprogram/ ./

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,id=linkcloud-space-pnpm \
    pnpm install --frozen-lockfile && pnpm build:h5


# ------------------------------------------------------------
# STAGE 4: Prod
# ------------------------------------------------------------

FROM base AS prod

WORKDIR /srv/app

RUN set -ex \
    && groupadd -r app --gid=1000 && useradd --uid=1000 --create-home --home-dir=/home/app --no-log-init -r -g app app \
    && echo "\nsource /opt/venv/bin/activate" >> /home/app/.bashrc

COPY --chown=app:app . .

RUN mkdir -p /srv/app/collected_static && chown -R app:app /srv/app/collected_static

USER app

COPY --from=admin_assets --chown=app:app /build/frontend_admin/dist/ ./public/static/dist/admin/
COPY --from=h5_assets --chown=app:app /build/frontend_miniprogram/dist/build/h5/ ./public/static/dist/h5/

RUN DJANGO_SETTINGS_MODULE=config.settings SECRET_KEY=build-only python manage.py collectstatic --noinput --no-default-ignore

CMD ["gunicorn", "--config=gunicorn.conf.py", "config.wsgi:application"]
